{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "fidelity": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "SECTOR_MIRROR_API_URL",
        "SECTOR_MIRROR_JWT_SECRET",
        "SECTOR_FIDELITY_MONGODB_URI"
      ]
    }
  }
}
